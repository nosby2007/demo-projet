{
  "rules": {
    ".read": false,
    ".write": false,
    "tenants": {
      "$tenantId": {
        "public": {
          ".read": true,
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() == 'admin'"
        }
      }
    },
    "roleRequests": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() == 'admin'",
      ".indexOn": ["createdAt", "updatedAt", "status", "tenantId"],
      "$requestId": {
        ".write": "auth != null && ((!data.exists() && auth.token.email_verified == true && newData.child('requesterUid').val() == auth.uid && newData.child('status').val() == 'pending') || root.child('profiles').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['type', 'name', 'email', 'phone', 'requesterUid', 'status']) && (newData.child('type').val() == 'seller' || newData.child('type').val() == 'courier')"
      }
    },
    "profiles": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() == 'admin'",
      ".indexOn": ["role", "tenantId", "status", "updatedAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('profiles').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && ((root.child('profiles').child(auth.uid).child('role').val() == 'admin' && auth.token.isSuperAdmin == true) || (auth.uid == $uid && data.exists() && newData.exists() && data.child('isSuperAdmin').val() != true && newData.child('isSuperAdmin').val() != true && newData.child('role').val() == data.child('role').val() && newData.child('status').val() == data.child('status').val() && newData.child('tenantId').val() == data.child('tenantId').val() && newData.child('isSuperAdmin').val() == data.child('isSuperAdmin').val()))",
        "isSuperAdmin": {
          ".validate": "newData.val() == data.val()"
        }
      }
    },
    "products": {
      ".read": false,
      ".write": false,
      ".indexOn": ["status", "sellerUid", "tenantId", "updatedAt"],
      "$productId": {
        ".write": false,
        ".validate": "newData.hasChildren(['name', 'price', 'category', 'status'])"
      }
    },
    "publicCatalog": {
      "$tenantId": {
        ".read": true,
        ".write": false
      }
    },
    "checkoutReservations": {
      ".read": false,
      ".write": false,
      ".indexOn": ["expiresAt", "tenantId", "customerUid"]
    },
    "checkoutIdempotency": {
      ".read": false,
      ".write": false
    },
    "orders": {
      ".read": false,
      ".write": false,
      ".indexOn": ["tenantId", "customerUid", "status", "paymentStatus", "createdAt", "updatedAt"]
    },
    "customerOrders": {
      ".read": false,
      ".write": false
    },
    "sellerOrders": {
      ".read": false,
      ".write": false
    },
    "deliveryJobs": {
      ".read": false,
      ".write": false,
      ".indexOn": ["tenantId", "courierUid", "status", "updatedAt"]
    },
    "earnings": {
      ".read": false,
      ".write": false
    },
    "adminDailyMetrics": {
      ".read": false,
      ".write": false
    },
    "supportCases": {
      ".read": false,
      ".write": false,
      "$tenantId": { ".indexOn": ["updatedAt", "status", "priority", "assignedAdminUid", "slaDueAt"] }
    },
    "orderTracking": {
      "$orderId": {
        ".read": "auth != null && (root.child('orders').child($orderId).child('customerUid').val() == auth.uid || (root.child('orders').child($orderId).child('courierUid').val() == auth.uid && root.child('orders').child($orderId).child('status').val() == 'in_transit') || (root.child('profiles').child(auth.uid).child('role').val() == 'admin' && root.child('profiles').child(auth.uid).child('status').val() != 'disabled' && root.child('profiles').child(auth.uid).child('tenantId').val() == root.child('orders').child($orderId).child('tenantId').val()))",
        ".write": false,
        ".indexOn": ["updatedAt", "status"]
      }
    },
    "userNotifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && root.child('profiles').child(auth.uid).child('status').val() != 'disabled'",
        ".write": false,
        ".indexOn": ["createdAt", "readAt"]
      }
    },
    "auditLogs": {
      ".read": false,
      ".write": false,
      "$tenantId": {
        ".indexOn": ["createdAt", "action", "entityType", "entityId", "actorUid"]
      }
    }
  }
}
